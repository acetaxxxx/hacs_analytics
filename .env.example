# Required. Use a published seven-character commit tag or release tag from GHCR.
HOMEKEEPER_IMAGE_TAG=replace-with-published-tag

# Required. Use a long random value shared with the Home Assistant integration.
HOMEKEEPER_SHARED_TOKEN=change-this-to-a-random-secret

# Optional. Without this, deterministic reports are still stored with ai_failed.
GEMINI_API_KEY=

HOMEKEEPER_TIMEZONE=Asia/Taipei
HOMEKEEPER_PORT=8080
HOMEKEEPER_GEMINI_MODEL=gemini-2.5-flash

# Host directory for the SQLite database. Relative paths are resolved from
# this Compose file's directory; an absolute Windows path also works, e.g.
# C:/homekeeper/data
HOMEKEEPER_DATA_DIR=./data
